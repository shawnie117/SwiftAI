# local.properties.sample
# Copy this file to local.properties and fill in your actual values
# DO NOT commit local.properties to version control!

## This file is automatically generated by Android Studio.
## Location of the Android SDK
sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk

## Gemini API Key (Required)
## Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

## Note: google-services.json should be placed in app/ directory
## Download it from Firebase Console: https://console.firebase.google.com/

